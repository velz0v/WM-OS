<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer policy.
  Everything is excluded by default: the database, drafts, attachments, AI keys
  and exports must never leave the device through the system backup channel.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
